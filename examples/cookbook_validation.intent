// Cookbook Validation Task
// Validates documentation markdown against quality standards.

task "RustApiCookbookCheck" v1.0 {
  goal: "Validate documentation in the RustAPI cookbook"

  input: docs_file: path = "./testdata/cookbook_sample.md"

  constraints: {
    net = off,
    fs = on
  }

  checks: {
    must_have_sections("Overview"),
    must_not_contain("TODO")
  }

  run:
    read_file(docs_file) ->
    parse_markdown ->
    validate ->
    report("json")
}