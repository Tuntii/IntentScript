// OpenAPI Lint Task
// Validates an OpenAPI specification file against RustAPI policies.

task "RustApiOpenApiLint" v1.0 {
  goal: "Enforce OpenAPI policy for RustAPI projects"

  input: openapi_file: path

  constraints: {
    net = off,
    fs = on
  }

  checks: {
    must_include_paths_prefix("/api"),
    must_have_security_schemes("bearerAuth")
  }

  run:
    read_file(openapi_file) ->
    parse_openapi ->
    validate ->
    report("markdown")
}